{
  "compilerOptions":{
    "target":"ES2020",
    "lib":["DOM","ES2020"],
    "module":"ESNext",
    "moduleResolution":"Bundler",
    "resolveJsonModule":true,
    "esModuleInterop":true,
    "allowSyntheticDefaultImports":true,
    "jsx":"react-jsx",
    "strict":true,
    "skipLibCheck":true,
    "noEmit":true
  },
  "include":["src/**/*.ts","src/**/*.tsx","../shared/remotion-templates/**/*.tsx"]
}
